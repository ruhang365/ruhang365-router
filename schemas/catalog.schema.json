{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ruhang365/ruhang365-router/schemas/catalog.schema.json",
  "title": "Ruhang365 Community Catalog",
  "description": "Deterministic cross-carrier catalog contract.",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogVersion",
    "contentDigest",
    "sourceRepository",
    "items"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "catalogVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRepository": {
      "const": "https://github.com/ruhang365/ruhang365-router"
    },
    "items": {"type": "array"}
  },
  "additionalProperties": false
}
