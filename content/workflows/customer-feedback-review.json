  "scenario_ids": ["r365.scenario.customer-feedback-review"],
  "nodes": [
    {
      "id": "sanitize-input",
      "title": "脱敏并界定样本",
      "action": "删除可识别信息，记录时间范围、渠道与样本量。",
      "resource_ids": [],
      "prompt_ids": [],
      "completion_criteria": ["输入无可识别顾客信息，样本边界明确。"]
    },
    {
      "id": "classify-feedback",
      "title": "分类并保留证据",
      "action": "按优势、问题、期待和例外情况分类，并保留脱敏摘录。",
      "resource_ids": [],
      "prompt_ids": ["r365.prompt.customer-feedback-review"],
      "completion_criteria": ["分类互斥且每项结论至少有一条证据。"]
    },
    {
      "id": "prioritize-actions",
      "title": "形成优先改进动作",
      "action": "按影响、频率、成本和可逆性选择三条动作。",
      "resource_ids": [],
      "prompt_ids": [],
      "completion_criteria": ["三条动作均有优先级和验证信号。"]
