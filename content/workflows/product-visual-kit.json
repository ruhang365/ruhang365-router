  "completion_criteria": [
    "产品名称、卖点、限制和准确文字已经确认。",
    "三个方向在构图或情绪上有明显取舍。",
    "最终 Prompt 包含用途、比例、文字、禁用项和核验要求。"
  ],
  "tags": ["产品视觉", "海报", "生图", "Workflow"],
  "match_terms": ["产品海报", "门店视觉", "商品图", "封面", "中文排版"],
  "goal": "形成三个可比较的视觉方向和一条准确、可执行的生成 Prompt。",
  "estimated_minutes": 30,
  "scenario_ids": ["r365.scenario.product-visual-kit"],
  "nodes": [
    {
      "id": "lock-product-facts",
      "title": "锁定产品事实与用途",
      "action": "确认产品名称、卖点、准确文字、目标平台、比例和禁用项。",
      "resource_ids": [],
      "prompt_ids": [],
      "completion_criteria": ["用途、比例、准确文字和禁用项齐全。"]
    },
    {
      "id": "compare-directions",
      "title": "比较三个视觉方向",
      "action": "分别给出信息型、场景型和品牌型方向，说明各自取舍。",
      "resource_ids": ["r365.resource.visual-prompt-router"],
      "prompt_ids": ["r365.prompt.local-business-visual-brief"],
      "completion_criteria": ["三个方向用途清楚且没有互相重复。"]
    },
    {
      "id": "finalize-prompt",
      "title": "确定最终任务 Prompt",
      "action": "把选中方向编译成一条包含准确文字与核验要求的 Prompt。",
      "resource_ids": ["r365.resource.visual-prompt-router"],
      "prompt_ids": ["r365.prompt.local-business-visual-brief"],
      "completion_criteria": ["Prompt 可直接交给支持的视觉工具或设计师。"]
    }
  ]
