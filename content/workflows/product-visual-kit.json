  },
  "applicability": {
    "identities": ["local-business", "small-business-owner"],
    "goals": ["visual-content", "product-promotion"],
    "experience_levels": ["beginner", "intermediate"],
    "constraints": ["low-budget", "no-private-data", "cross-carrier"],
