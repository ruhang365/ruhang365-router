  "nodes": [
    {
      "id": "collect-facts",
      "title": "收集真实卖点与顾客问题",
      "action": "列出目标顾客、三个高频问题、三个已确认卖点和本周目标。",
      "resource_ids": ["r365.resource.public-knowledge-search"],
      "prompt_ids": [],
      "completion_criteria": ["目标顾客、问题、卖点和目标均有真实依据。"]
    },
    {
      "id": "plan-seven-topics",
      "title": "规划七条选题",
      "action": "让七条内容分别承担解释、证明、比较、答疑和行动引导。",
      "resource_ids": ["r365.resource.ai-writing-humanizer"],
      "prompt_ids": [],
      "completion_criteria": ["七条选题不重复，并分别对应顾客问题。"]
    },
    {
      "id": "draft-and-visual",
      "title": "完成首篇文案与封面方向",
      "action": "完成首篇草稿，再确定用途、比例、准确文字和视觉重点。",
      "resource_ids": ["r365.resource.ai-writing-humanizer", "r365.resource.visual-prompt-router"],
      "prompt_ids": ["r365.prompt.local-business-visual-brief"],
      "completion_criteria": ["首篇草稿可编辑，封面方向可执行且没有虚构信息。"]
    }
  ]
