{
  "schema_version": "1.0.0",
  "id": "r365.prompt.customer-feedback-review",
  "type": "prompt",
  "slug": "customer-feedback-review",
  "version": "1.0.0",
  "title": "顾客反馈证据化整理 Prompt",
  "summary": "对脱敏顾客反馈做可回溯分类，不把样本频率夸大成普遍结论。",
  "status": "current",
  "governance": {
    "source": {
      "kind": "owned",
      "url": "https://github.com/ruhang365/ruhang365-router/blob/main/content/prompts/customer-feedback-review.json"
    },
    "license": {"spdx": "CC-BY-4.0", "attribution": "入行365"},
    "maintainers": ["ruhang365-maintainers"],
    "review": {"status": "approved", "reviewed_at": "2026-08-12"},
    "updated_at": "2026-08-12",
    "stale_after": "2027-02-12",
    "stale": false
  },
  "applicability": {
    "identities": ["local-business", "small-business-owner"],
    "goals": ["customer-insight", "service-improvement"],
    "experience_levels": ["beginner", "intermediate"],
    "constraints": ["no-private-data", "cross-carrier"],
    "excluded_constraints": ["contains-private-customer-data"],
    "deliverables": ["customer-feedback-review"]
  },
  "completion_criteria": [
    "输出区分优势、问题、期待和例外。",
    "每条结论都引用脱敏证据编号。",
    "动作优先级说明影响、频率、成本与验证方式。"
  ],
  "tags": ["Prompt", "顾客反馈", "证据", "服务改进"],
  "match_terms": ["评论整理", "差评分析", "用户反馈", "顾客洞察"],
  "purpose": "把脱敏反馈整理为有证据边界的结论和改进动作。",
  "template": "请分析以下已经脱敏的 {{feedback_items}}。样本边界是 {{sample_scope}}。先按优势、问题、期待、例外分类；每条结论引用反馈编号并标注出现次数，不得把小样本写成普遍事实。最后按影响、频率、成本和可逆性提出三条动作，并给出各自的验证信号。",
  "variables": ["feedback_items", "sample_scope"],
  "resource_ids": []
}
